% m3llvmir: an M3CG back end that writes textual LLVM IR (.ll).
% It does not link against LLVM; the .ll file is compiled by the
% system's clang (see compile_llvm_ir in cminstall's Unix.common).

import ("libm3")
import ("m3middle")

Module ("M3LLVMIR")
Module ("M3LLVMIRDebug")  % Phase 5: debug information

% Phase 5: gdb pretty-printers, embedded in each unit with debug
% information (see M3LLVMIRDebug.Finish)
resource ("m3printers.py")
bundle ("M3LLVMIRBundle")

% Phase 6: install the debugger scripts in INSTALL_ROOT/share/m3llvmir,
% so ~/.gdbinit or ~/.lldbinit can load them from there.  m3lldb.py
% imports m3printers.py from its own directory.
RootExport ("m3printers.py", "share/m3llvmir")
RootExport ("m3lldb.py", "share/m3llvmir")

Library ("m3llvmir")
