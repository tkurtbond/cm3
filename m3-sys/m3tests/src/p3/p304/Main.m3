  EXCEPT RuntimeError.E (t) => Bad ("64: -3037000500 * 3037000500", t) END;
  TRY a64 := VAL (4294967296L, S64);  b64 := VAL (4294967296L, S64);
    Ok ("64: 2^32 * 2^32", VAL (a64 * b64, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: 2^32 * 2^32", t) END;
  TRY a64 := VAL (-4294967296L, S64);  b64 := VAL (-2147483648L, S64);
    Ok ("64: -2^32 * -2^31", VAL (a64 * b64, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: -2^32 * -2^31", t) END;
  TRY a64 := VAL (-4294967296L, S64);  b64 := VAL (2147483648L, S64);
    Ok ("64: -2^32 * 2^31", VAL (a64 * b64, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: -2^32 * 2^31", t) END;
  TRY a64 := VAL (3L, S64);  b64 := VAL (6148914691236517206L, S64);
    Ok ("64: 3 * 6148914691236517206", VAL (a64 * b64, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: 3 * 6148914691236517206", t) END;
  TRY a64 := VAL (3L, S64);  b64 := VAL (3074457345618258602L, S64);
    Ok ("64: 3 * 3074457345618258602", VAL (a64 * b64, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: 3 * 3074457345618258602", t) END;
  TRY a64 := FIRST (S64);  b64 := VAL (-1L, S64);
    Ok ("64: FIRST DIV -1", VAL (a64 DIV b64, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: FIRST DIV -1", t) END;
  TRY a64 := VAL (-9223372036854775807L, S64);  b64 := VAL (-1L, S64);
    Ok ("64: FIRST+1 DIV -1", VAL (a64 DIV b64, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: FIRST+1 DIV -1", t) END;
  TRY a64 := FIRST (S64);  b64 := VAL (-1L, S64);
    Ok ("64: FIRST MOD -1", VAL (a64 MOD b64, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: FIRST MOD -1", t) END;
  TRY a64 := FIRST (S64);  b64 := VAL (1L, S64);
    Ok ("64: FIRST DIV 1", VAL (a64 DIV b64, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: FIRST DIV 1", t) END;
  TRY a64 := FIRST (S64);
    Ok ("64: -FIRST", VAL (-a64, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: -FIRST", t) END;
  TRY a64 := VAL (-9223372036854775807L, S64);
    Ok ("64: -(FIRST+1)", VAL (-a64, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: -(FIRST+1)", t) END;
  TRY a64 := FIRST (S64);
    Ok ("64: ABS (FIRST)", VAL (ABS (a64), LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: ABS (FIRST)", t) END;
  TRY a64 := VAL (-9223372036854775807L, S64);
    Ok ("64: ABS (FIRST+1)", VAL (ABS (a64), LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: ABS (FIRST+1)", t) END;
  TRY a64 := VAL (9223372036854775807L, S64);
    INC (a64);  Ok ("64: INC (LAST)", VAL (a64, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: INC (LAST)", t) END;
  TRY a64 := VAL (9223372036854775806L, S64);
    INC (a64);  Ok ("64: INC (LAST-1)", VAL (a64, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: INC (LAST-1)", t) END;
  TRY a64 := FIRST (S64);
    DEC (a64);  Ok ("64: DEC (FIRST)", VAL (a64, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: DEC (FIRST)", t) END;
  TRY a64 := VAL (-9223372036854775807L, S64);
    DEC (a64);  Ok ("64: DEC (FIRST+1)", VAL (a64, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: DEC (FIRST+1)", t) END;
  TRY a64 := VAL (9223372036854775807L, S64);  b64 := VAL (1L, S64);
    INC (a64, b64);  Ok ("64: INC (LAST, T 1)", VAL (a64, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: INC (LAST, T 1)", t) END;
  TRY a64 := FIRST (S64);  b64 := VAL (1L, S64);
    DEC (a64, b64);  Ok ("64: DEC (FIRST, T 1)", VAL (a64, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: DEC (FIRST, T 1)", t) END;
  TRY a64 := VAL (0L, S64);  b64 := FIRST (S64);
    DEC (a64, b64);  Ok ("64: DEC (0, T FIRST)", VAL (a64, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: DEC (0, T FIRST)", t) END;
  TRY a64 := VAL (-1L, S64);  b64 := FIRST (S64);
    DEC (a64, b64);  Ok ("64: DEC (-1, T FIRST)", VAL (a64, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: DEC (-1, T FIRST)", t) END;
  TRY a64 := VAL (1L, S64);  n := LAST (INTEGER);
    INC (a64, n);  Ok ("64: INC (1, LAST (INTEGER))", VAL (a64, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: INC (1, LAST (INTEGER))", t) END;
  TRY a64 := VAL (0L, S64);  n := LAST (INTEGER);
    INC (a64, n);  Ok ("64: INC (0, LAST (INTEGER))", VAL (a64, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: INC (0, LAST (INTEGER))", t) END;
  TRY a64 := VAL (0L, S64);  n := FIRST (INTEGER);
    DEC (a64, n);  Ok ("64: DEC (0, FIRST (INTEGER))", VAL (a64, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: DEC (0, FIRST (INTEGER))", t) END;
  TRY a64 := VAL (-1L, S64);  n := FIRST (INTEGER);
    DEC (a64, n);  Ok ("64: DEC (-1, FIRST (INTEGER))", VAL (a64, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: DEC (-1, FIRST (INTEGER))", t) END;
  TRY 
    Ok ("64: const LAST + 1", VAL (LAST (S64) + VAL (1L, S64), LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: const LAST + 1", t) END;
  TRY 
    Ok ("64: const FIRST - 1", VAL (FIRST (S64) - VAL (1L, S64), LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: const FIRST - 1", t) END;
  TRY 
    Ok ("64: const -FIRST", VAL (-FIRST (S64), LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: const -FIRST", t) END;
  TRY 
    Ok ("64: const LAST * 2", VAL (LAST (S64) * VAL (2L, S64), LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: const LAST * 2", t) END;
  TRY 
    Ok ("64: const FIRST DIV -1", VAL (FIRST (S64) DIV VAL (-1L, S64), LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: const FIRST DIV -1", t) END;
  TRY 
    Ok ("64: const ABS (FIRST)", VAL (ABS (FIRST (S64)), LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: const ABS (FIRST)", t) END;
  TRY 
    Ok ("64: const LAST - 1 + 1", VAL (LAST (S64) - VAL (1L, S64) + VAL (1L, S64), LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("64: const LAST - 1 + 1", t) END;

  (* VAL and assignment keep their own error *)
  IO.Put ("-- VAL\n");
  TRY n := 128;
    Ok ("VAL (128, S8)", VAL (VAL (n, S8), LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("VAL (128, S8)", t) END;
  TRY n := 127;
    Ok ("VAL (127, S8)", VAL (VAL (n, S8), LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("VAL (127, S8)", t) END;
  TRY a16 := FIRST (S16);
    Ok ("VAL (FIRST (S16), S8)", VAL (VAL (a16, S8), LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("VAL (FIRST (S16), S8)", t) END;
  TRY n := LAST (INTEGER);
    Ok ("VAL (LAST (INTEGER), S32)", VAL (VAL (n, S32), LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("VAL (LAST (INTEGER), S32)", t) END;
  TRY a16 := VAL (4, S16);
    sub := a16;  Ok ("Sub16 := 4", VAL (sub, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("Sub16 := 4", t) END;
  TRY a16 := VAL (-3, S16);
    sub := a16;  Ok ("Sub16 := -3", VAL (sub, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("Sub16 := -3", t) END;
END Main.
