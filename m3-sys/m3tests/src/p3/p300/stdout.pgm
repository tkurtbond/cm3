== Word8, Size 8
-- Word8 inline
plus 10
minus 30
times 0
divide 7
mod 2
and 20
or f0
xor d0
not f
shift 0
shift- f
leftshift 0
rightshift f
rotate f
rotate- f
rotate+size f
leftrotate f
rightrotate f
extract c
insert dc
wrap ff
fromword fe
fromlong fd
lt TRUE
le TRUE
gt FALSE
ge FALSE
equal FALSE
toword 240
hash 240
compare 1
compare- -1
compare= 0
tolong 240
