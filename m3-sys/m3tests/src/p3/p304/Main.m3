(* This fork: overflow of the signed fixed-width integer types.  See readme. *)

MODULE Main;
IMPORT IO, Fmt, RuntimeError, Signed8, Signed16, Signed32, Signed64;

TYPE S8 = Signed8.T;  S16 = Signed16.T;  S32 = Signed32.T;  S64 = Signed64.T;
  Sub16 = [VAL (-3, S16) .. VAL (3, S16)];

VAR
  a8, b8: S8;  a16, b16: S16;  a32, b32: S32;  a64, b64: S64;
  n: INTEGER;  sub: Sub16;

PROCEDURE Ok (name: TEXT;  r: LONGINT) =
  BEGIN IO.Put (name & " = " & Fmt.LongInt (r) & "\n") END Ok;

PROCEDURE Bad (name: TEXT;  t: RuntimeError.T) =
  BEGIN IO.Put (name & ": " & RuntimeError.Tag (t) & "\n") END Bad;

BEGIN

  (* 8 bits *)
  IO.Put ("-- 8 bits\n");
  TRY a8 := VAL (127, S8);  b8 := VAL (1, S8);
    Ok ("8: LAST + 1", VAL (a8 + b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: LAST + 1", t) END;
  TRY a8 := VAL (126, S8);  b8 := VAL (1, S8);
    Ok ("8: LAST-1 + 1", VAL (a8 + b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: LAST-1 + 1", t) END;
  TRY a8 := VAL (-128, S8);  b8 := VAL (-1, S8);
    Ok ("8: FIRST + -1", VAL (a8 + b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: FIRST + -1", t) END;
  TRY a8 := VAL (-127, S8);  b8 := VAL (-1, S8);
    Ok ("8: FIRST+1 + -1", VAL (a8 + b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: FIRST+1 + -1", t) END;
  TRY a8 := VAL (127, S8);  b8 := VAL (127, S8);
    Ok ("8: LAST + LAST", VAL (a8 + b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: LAST + LAST", t) END;
  TRY a8 := VAL (-128, S8);  b8 := VAL (-128, S8);
    Ok ("8: FIRST + FIRST", VAL (a8 + b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: FIRST + FIRST", t) END;
  TRY a8 := VAL (127, S8);  b8 := VAL (-128, S8);
    Ok ("8: LAST + FIRST", VAL (a8 + b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: LAST + FIRST", t) END;
  TRY a8 := VAL (-128, S8);  b8 := VAL (1, S8);
    Ok ("8: FIRST - 1", VAL (a8 - b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: FIRST - 1", t) END;
  TRY a8 := VAL (-127, S8);  b8 := VAL (1, S8);
    Ok ("8: FIRST+1 - 1", VAL (a8 - b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: FIRST+1 - 1", t) END;
  TRY a8 := VAL (127, S8);  b8 := VAL (-1, S8);
    Ok ("8: LAST - -1", VAL (a8 - b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: LAST - -1", t) END;
  TRY a8 := VAL (126, S8);  b8 := VAL (-1, S8);
    Ok ("8: LAST-1 - -1", VAL (a8 - b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: LAST-1 - -1", t) END;
  TRY a8 := VAL (0, S8);  b8 := VAL (-128, S8);
    Ok ("8: 0 - FIRST", VAL (a8 - b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: 0 - FIRST", t) END;
  TRY a8 := VAL (-1, S8);  b8 := VAL (-128, S8);
    Ok ("8: -1 - FIRST", VAL (a8 - b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: -1 - FIRST", t) END;
  TRY a8 := VAL (-128, S8);  b8 := VAL (127, S8);
    Ok ("8: FIRST - LAST", VAL (a8 - b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: FIRST - LAST", t) END;
  TRY a8 := VAL (-1, S8);  b8 := VAL (127, S8);
    Ok ("8: -1 - LAST", VAL (a8 - b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: -1 - LAST", t) END;
  TRY a8 := VAL (-128, S8);  b8 := VAL (-1, S8);
    Ok ("8: FIRST * -1", VAL (a8 * b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: FIRST * -1", t) END;
  TRY a8 := VAL (-1, S8);  b8 := VAL (-128, S8);
    Ok ("8: -1 * FIRST", VAL (a8 * b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: -1 * FIRST", t) END;
  TRY a8 := VAL (-127, S8);  b8 := VAL (-1, S8);
    Ok ("8: FIRST+1 * -1", VAL (a8 * b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: FIRST+1 * -1", t) END;
  TRY a8 := VAL (-1, S8);  b8 := VAL (127, S8);
    Ok ("8: -1 * LAST", VAL (a8 * b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: -1 * LAST", t) END;
  TRY a8 := VAL (-128, S8);  b8 := VAL (1, S8);
    Ok ("8: FIRST * 1", VAL (a8 * b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: FIRST * 1", t) END;
  TRY a8 := VAL (-128, S8);  b8 := VAL (0, S8);
    Ok ("8: FIRST * 0", VAL (a8 * b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: FIRST * 0", t) END;
  TRY a8 := VAL (127, S8);  b8 := VAL (2, S8);
    Ok ("8: LAST * 2", VAL (a8 * b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: LAST * 2", t) END;
  TRY a8 := VAL (2, S8);  b8 := VAL (127, S8);
    Ok ("8: 2 * LAST", VAL (a8 * b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: 2 * LAST", t) END;
  TRY a8 := VAL (-128, S8);  b8 := VAL (2, S8);
    Ok ("8: FIRST * 2", VAL (a8 * b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: FIRST * 2", t) END;
  TRY a8 := VAL (-64, S8);  b8 := VAL (2, S8);
    Ok ("8: FIRST/2 * 2", VAL (a8 * b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: FIRST/2 * 2", t) END;
  TRY a8 := VAL (2, S8);  b8 := VAL (-64, S8);
    Ok ("8: 2 * FIRST/2", VAL (a8 * b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: 2 * FIRST/2", t) END;
  TRY a8 := VAL (-2, S8);  b8 := VAL (64, S8);
    Ok ("8: -2 * -FIRST/2", VAL (a8 * b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: -2 * -FIRST/2", t) END;
  TRY a8 := VAL (64, S8);  b8 := VAL (2, S8);
    Ok ("8: -FIRST/2 * 2", VAL (a8 * b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: -FIRST/2 * 2", t) END;
  TRY a8 := VAL (11, S8);  b8 := VAL (11, S8);
    Ok ("8: 11 * 11", VAL (a8 * b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: 11 * 11", t) END;
  TRY a8 := VAL (12, S8);  b8 := VAL (12, S8);
    Ok ("8: 12 * 12", VAL (a8 * b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: 12 * 12", t) END;
  TRY a8 := VAL (-12, S8);  b8 := VAL (12, S8);
    Ok ("8: -12 * 12", VAL (a8 * b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: -12 * 12", t) END;
  TRY a8 := VAL (-128, S8);  b8 := VAL (-1, S8);
    Ok ("8: FIRST DIV -1", VAL (a8 DIV b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: FIRST DIV -1", t) END;
  TRY a8 := VAL (-127, S8);  b8 := VAL (-1, S8);
    Ok ("8: FIRST+1 DIV -1", VAL (a8 DIV b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: FIRST+1 DIV -1", t) END;
  TRY a8 := VAL (-128, S8);  b8 := VAL (-1, S8);
    Ok ("8: FIRST MOD -1", VAL (a8 MOD b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: FIRST MOD -1", t) END;
  TRY a8 := VAL (-128, S8);  b8 := VAL (1, S8);
    Ok ("8: FIRST DIV 1", VAL (a8 DIV b8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: FIRST DIV 1", t) END;
  TRY a8 := VAL (-128, S8);
    Ok ("8: -FIRST", VAL (-a8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: -FIRST", t) END;
  TRY a8 := VAL (-127, S8);
    Ok ("8: -(FIRST+1)", VAL (-a8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: -(FIRST+1)", t) END;
  TRY a8 := VAL (-128, S8);
    Ok ("8: ABS (FIRST)", VAL (ABS (a8), LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: ABS (FIRST)", t) END;
  TRY a8 := VAL (-127, S8);
    Ok ("8: ABS (FIRST+1)", VAL (ABS (a8), LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: ABS (FIRST+1)", t) END;
  TRY a8 := VAL (127, S8);
    INC (a8);  Ok ("8: INC (LAST)", VAL (a8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: INC (LAST)", t) END;
  TRY a8 := VAL (126, S8);
    INC (a8);  Ok ("8: INC (LAST-1)", VAL (a8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: INC (LAST-1)", t) END;
  TRY a8 := VAL (-128, S8);
    DEC (a8);  Ok ("8: DEC (FIRST)", VAL (a8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: DEC (FIRST)", t) END;
  TRY a8 := VAL (-127, S8);
    DEC (a8);  Ok ("8: DEC (FIRST+1)", VAL (a8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: DEC (FIRST+1)", t) END;
  TRY a8 := VAL (127, S8);  b8 := VAL (1, S8);
    INC (a8, b8);  Ok ("8: INC (LAST, T 1)", VAL (a8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: INC (LAST, T 1)", t) END;
  TRY a8 := VAL (-128, S8);  b8 := VAL (1, S8);
    DEC (a8, b8);  Ok ("8: DEC (FIRST, T 1)", VAL (a8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: DEC (FIRST, T 1)", t) END;
  TRY a8 := VAL (0, S8);  b8 := VAL (-128, S8);
    DEC (a8, b8);  Ok ("8: DEC (0, T FIRST)", VAL (a8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: DEC (0, T FIRST)", t) END;
  TRY a8 := VAL (-1, S8);  b8 := VAL (-128, S8);
    DEC (a8, b8);  Ok ("8: DEC (-1, T FIRST)", VAL (a8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: DEC (-1, T FIRST)", t) END;
  TRY a8 := VAL (-128, S8);  n := 255;
    INC (a8, n);  Ok ("8: INC (FIRST, 255)", VAL (a8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: INC (FIRST, 255)", t) END;
  TRY a8 := VAL (-128, S8);  n := 256;
    INC (a8, n);  Ok ("8: INC (FIRST, 256)", VAL (a8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: INC (FIRST, 256)", t) END;
  TRY a8 := VAL (127, S8);  n := 255;
    DEC (a8, n);  Ok ("8: DEC (LAST, 255)", VAL (a8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: DEC (LAST, 255)", t) END;
  TRY a8 := VAL (127, S8);  n := 256;
    DEC (a8, n);  Ok ("8: DEC (LAST, 256)", VAL (a8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: DEC (LAST, 256)", t) END;
  TRY a8 := VAL (0, S8);  n := LAST (INTEGER);
    INC (a8, n);  Ok ("8: INC (0, LAST (INTEGER))", VAL (a8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: INC (0, LAST (INTEGER))", t) END;
  TRY a8 := VAL (0, S8);  n := FIRST (INTEGER);
    DEC (a8, n);  Ok ("8: DEC (0, FIRST (INTEGER))", VAL (a8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: DEC (0, FIRST (INTEGER))", t) END;
  TRY a8 := VAL (0, S8);  n := 128;
    INC (a8, n);  Ok ("8: INC (0, LAST+1)", VAL (a8, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: INC (0, LAST+1)", t) END;
  TRY 
    Ok ("8: const LAST + 1", VAL (LAST (S8) + VAL (1, S8), LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: const LAST + 1", t) END;
  TRY 
    Ok ("8: const FIRST - 1", VAL (FIRST (S8) - VAL (1, S8), LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: const FIRST - 1", t) END;
  TRY 
    Ok ("8: const -FIRST", VAL (-FIRST (S8), LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: const -FIRST", t) END;
  TRY 
    Ok ("8: const LAST * 2", VAL (LAST (S8) * VAL (2, S8), LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: const LAST * 2", t) END;
  TRY 
    Ok ("8: const FIRST DIV -1", VAL (FIRST (S8) DIV VAL (-1, S8), LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: const FIRST DIV -1", t) END;
  TRY 
    Ok ("8: const ABS (FIRST)", VAL (ABS (FIRST (S8)), LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: const ABS (FIRST)", t) END;
  TRY 
    Ok ("8: const LAST - 1 + 1", VAL (LAST (S8) - VAL (1, S8) + VAL (1, S8), LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("8: const LAST - 1 + 1", t) END;

  (* 16 bits *)
  IO.Put ("-- 16 bits\n");
  TRY a16 := VAL (32767, S16);  b16 := VAL (1, S16);
    Ok ("16: LAST + 1", VAL (a16 + b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: LAST + 1", t) END;
  TRY a16 := VAL (32766, S16);  b16 := VAL (1, S16);
    Ok ("16: LAST-1 + 1", VAL (a16 + b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: LAST-1 + 1", t) END;
  TRY a16 := VAL (-32768, S16);  b16 := VAL (-1, S16);
    Ok ("16: FIRST + -1", VAL (a16 + b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: FIRST + -1", t) END;
  TRY a16 := VAL (-32767, S16);  b16 := VAL (-1, S16);
    Ok ("16: FIRST+1 + -1", VAL (a16 + b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: FIRST+1 + -1", t) END;
  TRY a16 := VAL (32767, S16);  b16 := VAL (32767, S16);
    Ok ("16: LAST + LAST", VAL (a16 + b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: LAST + LAST", t) END;
  TRY a16 := VAL (-32768, S16);  b16 := VAL (-32768, S16);
    Ok ("16: FIRST + FIRST", VAL (a16 + b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: FIRST + FIRST", t) END;
  TRY a16 := VAL (32767, S16);  b16 := VAL (-32768, S16);
    Ok ("16: LAST + FIRST", VAL (a16 + b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: LAST + FIRST", t) END;
  TRY a16 := VAL (-32768, S16);  b16 := VAL (1, S16);
    Ok ("16: FIRST - 1", VAL (a16 - b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: FIRST - 1", t) END;
  TRY a16 := VAL (-32767, S16);  b16 := VAL (1, S16);
    Ok ("16: FIRST+1 - 1", VAL (a16 - b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: FIRST+1 - 1", t) END;
  TRY a16 := VAL (32767, S16);  b16 := VAL (-1, S16);
    Ok ("16: LAST - -1", VAL (a16 - b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: LAST - -1", t) END;
  TRY a16 := VAL (32766, S16);  b16 := VAL (-1, S16);
    Ok ("16: LAST-1 - -1", VAL (a16 - b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: LAST-1 - -1", t) END;
  TRY a16 := VAL (0, S16);  b16 := VAL (-32768, S16);
    Ok ("16: 0 - FIRST", VAL (a16 - b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: 0 - FIRST", t) END;
  TRY a16 := VAL (-1, S16);  b16 := VAL (-32768, S16);
    Ok ("16: -1 - FIRST", VAL (a16 - b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: -1 - FIRST", t) END;
  TRY a16 := VAL (-32768, S16);  b16 := VAL (32767, S16);
    Ok ("16: FIRST - LAST", VAL (a16 - b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: FIRST - LAST", t) END;
  TRY a16 := VAL (-1, S16);  b16 := VAL (32767, S16);
    Ok ("16: -1 - LAST", VAL (a16 - b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: -1 - LAST", t) END;
  TRY a16 := VAL (-32768, S16);  b16 := VAL (-1, S16);
    Ok ("16: FIRST * -1", VAL (a16 * b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: FIRST * -1", t) END;
  TRY a16 := VAL (-1, S16);  b16 := VAL (-32768, S16);
    Ok ("16: -1 * FIRST", VAL (a16 * b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: -1 * FIRST", t) END;
  TRY a16 := VAL (-32767, S16);  b16 := VAL (-1, S16);
    Ok ("16: FIRST+1 * -1", VAL (a16 * b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: FIRST+1 * -1", t) END;
  TRY a16 := VAL (-1, S16);  b16 := VAL (32767, S16);
    Ok ("16: -1 * LAST", VAL (a16 * b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: -1 * LAST", t) END;
  TRY a16 := VAL (-32768, S16);  b16 := VAL (1, S16);
    Ok ("16: FIRST * 1", VAL (a16 * b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: FIRST * 1", t) END;
  TRY a16 := VAL (-32768, S16);  b16 := VAL (0, S16);
    Ok ("16: FIRST * 0", VAL (a16 * b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: FIRST * 0", t) END;
  TRY a16 := VAL (32767, S16);  b16 := VAL (2, S16);
    Ok ("16: LAST * 2", VAL (a16 * b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: LAST * 2", t) END;
  TRY a16 := VAL (2, S16);  b16 := VAL (32767, S16);
    Ok ("16: 2 * LAST", VAL (a16 * b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: 2 * LAST", t) END;
  TRY a16 := VAL (-32768, S16);  b16 := VAL (2, S16);
    Ok ("16: FIRST * 2", VAL (a16 * b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: FIRST * 2", t) END;
  TRY a16 := VAL (-16384, S16);  b16 := VAL (2, S16);
    Ok ("16: FIRST/2 * 2", VAL (a16 * b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: FIRST/2 * 2", t) END;
  TRY a16 := VAL (2, S16);  b16 := VAL (-16384, S16);
    Ok ("16: 2 * FIRST/2", VAL (a16 * b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: 2 * FIRST/2", t) END;
  TRY a16 := VAL (-2, S16);  b16 := VAL (16384, S16);
    Ok ("16: -2 * -FIRST/2", VAL (a16 * b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: -2 * -FIRST/2", t) END;
  TRY a16 := VAL (16384, S16);  b16 := VAL (2, S16);
    Ok ("16: -FIRST/2 * 2", VAL (a16 * b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: -FIRST/2 * 2", t) END;
  TRY a16 := VAL (181, S16);  b16 := VAL (181, S16);
    Ok ("16: 181 * 181", VAL (a16 * b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: 181 * 181", t) END;
  TRY a16 := VAL (182, S16);  b16 := VAL (182, S16);
    Ok ("16: 182 * 182", VAL (a16 * b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: 182 * 182", t) END;
  TRY a16 := VAL (-182, S16);  b16 := VAL (182, S16);
    Ok ("16: -182 * 182", VAL (a16 * b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: -182 * 182", t) END;
  TRY a16 := VAL (-32768, S16);  b16 := VAL (-1, S16);
    Ok ("16: FIRST DIV -1", VAL (a16 DIV b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: FIRST DIV -1", t) END;
  TRY a16 := VAL (-32767, S16);  b16 := VAL (-1, S16);
    Ok ("16: FIRST+1 DIV -1", VAL (a16 DIV b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: FIRST+1 DIV -1", t) END;
  TRY a16 := VAL (-32768, S16);  b16 := VAL (-1, S16);
    Ok ("16: FIRST MOD -1", VAL (a16 MOD b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: FIRST MOD -1", t) END;
  TRY a16 := VAL (-32768, S16);  b16 := VAL (1, S16);
    Ok ("16: FIRST DIV 1", VAL (a16 DIV b16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: FIRST DIV 1", t) END;
  TRY a16 := VAL (-32768, S16);
    Ok ("16: -FIRST", VAL (-a16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: -FIRST", t) END;
  TRY a16 := VAL (-32767, S16);
    Ok ("16: -(FIRST+1)", VAL (-a16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: -(FIRST+1)", t) END;
  TRY a16 := VAL (-32768, S16);
    Ok ("16: ABS (FIRST)", VAL (ABS (a16), LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: ABS (FIRST)", t) END;
  TRY a16 := VAL (-32767, S16);
    Ok ("16: ABS (FIRST+1)", VAL (ABS (a16), LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: ABS (FIRST+1)", t) END;
  TRY a16 := VAL (32767, S16);
    INC (a16);  Ok ("16: INC (LAST)", VAL (a16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: INC (LAST)", t) END;
  TRY a16 := VAL (32766, S16);
    INC (a16);  Ok ("16: INC (LAST-1)", VAL (a16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: INC (LAST-1)", t) END;
  TRY a16 := VAL (-32768, S16);
    DEC (a16);  Ok ("16: DEC (FIRST)", VAL (a16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: DEC (FIRST)", t) END;
  TRY a16 := VAL (-32767, S16);
    DEC (a16);  Ok ("16: DEC (FIRST+1)", VAL (a16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: DEC (FIRST+1)", t) END;
  TRY a16 := VAL (32767, S16);  b16 := VAL (1, S16);
    INC (a16, b16);  Ok ("16: INC (LAST, T 1)", VAL (a16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: INC (LAST, T 1)", t) END;
  TRY a16 := VAL (-32768, S16);  b16 := VAL (1, S16);
    DEC (a16, b16);  Ok ("16: DEC (FIRST, T 1)", VAL (a16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: DEC (FIRST, T 1)", t) END;
  TRY a16 := VAL (0, S16);  b16 := VAL (-32768, S16);
    DEC (a16, b16);  Ok ("16: DEC (0, T FIRST)", VAL (a16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: DEC (0, T FIRST)", t) END;
  TRY a16 := VAL (-1, S16);  b16 := VAL (-32768, S16);
    DEC (a16, b16);  Ok ("16: DEC (-1, T FIRST)", VAL (a16, LONGINT));
  EXCEPT RuntimeError.E (t) => Bad ("16: DEC (-1, T FIRST)", t) END;
  TRY a16 := VAL (-32768, S16);  n := 65535;
