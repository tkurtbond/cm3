Generic_interface("GenWord")
Interface("WordRep")
Interface("Word")
Interface("LongRep")
Interface("Long")

generic_implementation("GenWord")
implementation ("Word")
implementation ("Long")

% This fork: the units of the unsigned fixed-width integer interfaces
% Word8 .. Word64 (see GenWordN.ig).  Each WordNRep imports the builtin
% interface WordN, which only a compiler that defines
% M3_FIXED_WIDTH_INTEGERS has; an older one (a bootstrap compiler, say)
% would instead find WordN.i3 here and report a circular import.  So
% build them only with a compiler that has the builtins: upgrading from
% an older compiler leaves them out of the first pass and builds them
% in the next.
if defined("M3_FIXED_WIDTH_INTEGERS")
  Generic_interface("GenWordN")
  generic_implementation("GenWordN")
  foreach n in [ "8", "16", "32", "64" ]
    Interface("Word" & n & "Rep")
    Interface("Word" & n)
    implementation("Word" & n)
  end
end
